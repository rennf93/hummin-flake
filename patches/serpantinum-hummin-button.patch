diff -ruN a/src/quickshell/guide/HumminTab.qml b/src/quickshell/guide/HumminTab.qml
--- a/src/quickshell/guide/HumminTab.qml	1970-01-01 01:00:00.000000000 +0100
+++ b/src/quickshell/guide/HumminTab.qml	2026-11-09 03:16:08.655208572 +0100
@@ -0,0 +1,194 @@
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls
+import Quickshell
+import Quickshell.Services.SystemTray
+import "../"
+import "../reusables"
+
+// hummin-menubar's tray menu as a Settings page: a card per host, a row per model with Start, Stop and
+// Restart. Hummin stays in charge: every control triggers the matching entry of its menu.
+GuideTab {
+    id: humminTabRoot
+
+    readonly property var trayItem: {
+        let arr = SystemTray.items.values || [];
+        for (let i = 0; i < arr.length; i++) if (arr[i] && arr[i].id === "hummin-menubar") return arr[i];
+        return null;
+    }
+
+    QsMenuOpener {
+        id: rootMenu
+        menu: humminTabRoot.trayItem ? humminTabRoot.trayItem.menu : null
+    }
+    readonly property var entries: rootMenu.children ? (rootMenu.children.values || []) : []
+
+    // The menu: a summary line ("All servers stopped"), then per host (servers.json's hostOrder) a disabled
+    // header entry and its models, each with Start/Stop/Restart children; a separator ends it before "Quit menubar".
+    readonly property string summary: (entries.length > 0 && !entries[0].hasChildren && entries[0].enabled) ? entries[0].text : ""
+    readonly property var groups: {
+        let out = [];
+        for (let i = 0; i < entries.length; i++) {
+            let e = entries[i];
+            if (!e) continue;
+            if (e.isSeparator) break;
+            if (e.hasChildren) {
+                if (out.length === 0) out.push({ host: "", servers: [] });
+                out[out.length - 1].servers.push(e);
+            } else if (!e.enabled) {
+                out.push({ host: e.text, servers: [] });
+            }
+        }
+        return out;
+    }
+
+    // "Bonsai 2 27B (ternary) :9996  ●": ● up, ◐ busy, ○ down, optionally " ·mode" before the dot and
+    // "  starting..." after it (hummin_menubar/app.py render())
+    function parse(label) {
+        let m = /^(.*?)\s+:(\d+)(?:\s+·\S+)?\s+([●◐○])/.exec(label || "");
+        if (!m) return { name: label || "", port: "", state: "down" };
+        return { name: m[1], port: m[2], state: m[3] === "●" ? "up" : (m[3] === "◐" ? "busy" : "down") };
+    }
+
+    function stateLabel(state) {
+        return state === "up" ? "Running" : (state === "busy" ? "Working" : "Stopped");
+    }
+
+    function stateColor(state) {
+        return state === "up" ? ThemeBackend.green : (state === "busy" ? ThemeBackend.yellow : ThemeBackend.overlay0);
+    }
+
+    function hostIcon(host) {
+        if (host === "Laptop") return "󰌢";
+        if (host === "Mac") return "󰀵";
+        if (host === "NAS") return "󰒋";
+        return "󰒍";
+    }
+
+    function actionIcon(text) {
+        if (text === "Start") return "󰐊";
+        if (text === "Stop") return "󰓛";
+        if (text === "Restart") return "󰑐";
+        return "";
+    }
+
+    Flickable {
+        anchors.fill: parent
+        anchors.margins: rootObj.s(8)
+        contentHeight: settingsCol.implicitHeight
+        clip: true
+        boundsBehavior: Flickable.StopAtBounds
+
+        ColumnLayout {
+            id: settingsCol
+            width: parent.width
+            spacing: rootObj.s(6)
+
+            SettingsBlob {
+                visible: !humminTabRoot.trayItem
+                SettingsRow {
+                    rootObj: humminTabRoot.rootObj
+                    searchable: false
+                    icon: "󰀦"
+                    title: "hummin-menubar isn't running"
+                    description: "systemctl --user restart hummin-menubar"
+                }
+            }
+
+            Repeater {
+                model: humminTabRoot.groups
+
+                delegate: SettingsBlob {
+                    id: hostBlob
+                    property var groupData: modelData
+                    readonly property int running: groupData.servers.filter(e => humminTabRoot.parse(e.text).state === "up").length
+                    Layout.topMargin: index > 0 ? rootObj.s(6) : 0
+
+                    SettingsRow {
+                        rootObj: humminTabRoot.rootObj
+                        searchable: false
+                        icon: humminTabRoot.hostIcon(hostBlob.groupData.host)
+                        iconTextColor: ThemeBackend.mauve
+                        title: hostBlob.groupData.host
+                        titleBold: true
+                        description: hostBlob.running + " of " + hostBlob.groupData.servers.length + " running"
+                    }
+
+                    Repeater {
+                        model: hostBlob.groupData.servers
+                        delegate: ServerRow { entry: modelData }
+                    }
+                }
+            }
+        }
+    }
+
+    component ServerRow: SettingsRow {
+        id: row
+        property var entry: null
+        readonly property var info: humminTabRoot.parse(entry ? entry.text : "")
+
+        rootObj: humminTabRoot.rootObj
+        searchable: false
+        icon: "󰝥"
+        iconFontSize: 10
+        iconTextColor: humminTabRoot.stateColor(row.info.state)
+        title: row.info.name
+        description: ":" + row.info.port + "  ·  " + humminTabRoot.stateLabel(row.info.state)
+
+        QsMenuOpener {
+            id: actionsMenu
+            menu: row.entry
+        }
+        readonly property var actions: actionsMenu.children ? (actionsMenu.children.values || []) : []
+
+        // Token Proxy's "Mode": its children are the choices, the checked one current
+        Repeater {
+            model: row.actions.filter(a => a && a.hasChildren)
+            delegate: Item {
+                id: choice
+                property var choiceEntry: modelData
+                implicitWidth: rootObj.s(110)
+                implicitHeight: rootObj.s(32)
+
+                QsMenuOpener {
+                    id: choiceMenu
+                    menu: choice.choiceEntry
+                }
+                readonly property var options: choiceMenu.children ? (choiceMenu.children.values || []) : []
+
+                Dropdown {
+                    anchors.fill: parent
+                    options: choice.options.map(o => choice.choiceEntry.text + ": " + o.text)
+                    currentIndex: Math.max(0, choice.options.findIndex(o => o.checkState === Qt.Checked))
+                    accentColor: ThemeBackend.mauve
+                    baseColor: ThemeBackend.surface0
+                    hoverColor: ThemeBackend.surface1
+                    dropdownColor: ThemeBackend.surface0
+                    borderColor: Qt.alpha(ThemeBackend.surface2, 0.6)
+                    textColor: ThemeBackend.text
+                    activeTextColor: ThemeBackend.crust
+                    fontPixelSize: rootObj.s(11)
+                    onValueChanged: function(index, value) { if (choice.options[index]) choice.options[index].triggered(); }
+                }
+            }
+        }
+
+        Repeater {
+            model: row.actions.filter(a => a && !a.isSeparator && !a.hasChildren)
+            delegate: ClickButton {
+                implicitWidth: rootObj.s(96)
+                implicitHeight: rootObj.s(32)
+                buttonText: modelData.text
+                buttonIcon: humminTabRoot.actionIcon(modelData.text)
+                textFontSize: rootObj.s(11)
+                cornerRadius: ThemeBackend.borderRadius
+                enabled: modelData.enabled
+                opacity: enabled ? 1 : 0.35
+                accentColor: ThemeBackend.surface0
+                textColor: ThemeBackend.text
+                onClicked: modelData.triggered()
+            }
+        }
+    }
+}
